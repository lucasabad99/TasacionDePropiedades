# ==== Backend - Tasador Inmobiliario ====
# Copiá este archivo como .env y ajustá los valores. El .env NO se sube a git.

# development | staging | production
NODE_ENV=development

# Puerto de la API
PORT=3001

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173

# Carpeta donde se guardan las tasaciones (relativa a /backend)
DATA_DIR=./data

# true = el backend también sirve el frontend compilado (frontend/dist).
# Útil en staging para levantar todo con un solo proceso.
SERVE_FRONTEND=false

# ---- Sesiones ----
# Clave secreta para firmar las sesiones (mínimo 32 caracteres).
# OBLIGATORIA en staging/producción. Generar una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Duración de la sesión (horas)
SESION_HORAS=12

# ---- Modo demo ----
# true = el login muestra el cuadro con los accesos de prueba y se cargan
# tasaciones de ejemplo si no hay ninguna. APAGAR en producción.
DEMO_MODE=true

# MongoDB (staging / producción), ej. MongoDB Atlas: mongodb+srv://usuario:clave@cluster.xxxx.mongodb.net
# Si está vacío se usan archivos JSON en DATA_DIR, que en Render (plan gratis) se borran en cada reinicio.
MONGODB_URI=
MONGODB_DB=tasador
