# ==== Frontend - Tasador Inmobiliario ====
# Copiá este archivo como .env y ajustá los valores. El .env NO se sube a git.
# OJO: todo lo que empieza con VITE_ queda visible en el navegador.
# Nunca pongas claves ni secretos acá.

# Nombre que aparece en la barra y en el informe impreso
VITE_INMOBILIARIA_NOMBRE=Tasador Inmobiliario

# URL de la API. Vacío = mismo dominio que el frontend (recomendado).
# Solo completalo si el backend vive en otro dominio, ej: https://api-staging.midominio.com
VITE_API_URL=

# Solo desarrollo: puerto de Vite y a dónde redirigir /api
VITE_PORT=5173
VITE_API_PROXY=http://localhost:3001
